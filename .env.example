# Pi Mono is server-only; provide a provider/model and credential in .env.local.
PI_PROVIDER=
PI_MODEL=
PI_API_KEY=
# The app calls Ollama's OpenAI-compatible API only at this local endpoint.
OLLAMA_OPENAI_URL=http://127.0.0.1:11434/v1
# Enables the real local Ollama smoke only; ordinary tests use the fixture path.
OLLAMA_INTEGRATION=0
# Integration-test target (requires a running Ollama service):
# PI_PROVIDER=ollama
# PI_MODEL=glm-5.2:cloud
# Native build prerequisite: cargo and rustc >= 1.85 (build outside Next.js).

# Production requires the exact public HTTPS origin for same-origin mutation checks.
ODYSSEY_APP_ORIGIN=https://app.example.invalid
# Disabled by default. This only enables generic fixtures when NODE_ENV=development;
# it is ignored in production. Vitest supplies its own test-only fixture setting.
ODYSSEY_ENABLE_DEVELOPMENT_FIXTURE_ACCOUNTS=0

# First-parent bootstrap is disabled by default and has no public route. Set
# exactly one environment-specific flag plus both secret values only in ignored
# local configuration or deployment secret configuration. It only creates a
# parent while no parent account exists; it never resets an existing parent.
ODYSSEY_ENABLE_LOCAL_PARENT_BOOTSTRAP=0
ODYSSEY_ENABLE_PRODUCTION_PARENT_BOOTSTRAP=0
ODYSSEY_PARENT_BOOTSTRAP_USERNAME=
ODYSSEY_PARENT_BOOTSTRAP_PASSWORD=
