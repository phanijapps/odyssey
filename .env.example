# Local Engram setup. Values belong only in the Git-ignored .env.local file.
ENGRAM_APPROVED_ROOT=
ENGRAM_SOURCE_ROOT=
ENGRAM_ADDON_PATH=
ENGRAM_EXPECTED_REVISION=
ENGRAM_EXPECTED_CONTRACT_SHA256=
ENGRAM_EXPECTED_ADDON_SHA256=
# Absolute generated module entry beneath ENGRAM_SOURCE_ROOT; it must be packages/node/dist/index.js.
ENGRAM_NODE_PACKAGE_PATH=
# SHA-256 of every regular file in packages/node/dist, path-sorted and delimited.
ENGRAM_EXPECTED_PACKAGE_SHA256=
ENGRAM_NODE_PACKAGE=@engram/node
ENGRAM_DB_PATH=
ENGRAM_CONFIG_JSON=
# Pi Mono is server-only; provide a provider/model and credential in .env.local.
PI_PROVIDER=
PI_MODEL=
PI_API_KEY=
# Enables the real local Ollama smoke only; ordinary tests use the fixture path.
OLLAMA_INTEGRATION=0
# Integration-test target (requires a running Ollama service):
# PI_PROVIDER=ollama
# PI_MODEL=minimax-m2.7:cloud
# Native build prerequisite: cargo and rustc >= 1.85 (build outside Next.js).
