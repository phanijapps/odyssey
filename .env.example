# Local Engram setup. Values belong only in the Git-ignored .env.local file.
ENGRAM_APPROVED_ROOT=
ENGRAM_SOURCE_ROOT=
ENGRAM_ADDON_PATH=
ENGRAM_EXPECTED_REVISION=
ENGRAM_EXPECTED_CONTRACT_SHA256=
ENGRAM_EXPECTED_ADDON_SHA256=
# Absolute generated module entry beneath ENGRAM_SOURCE_ROOT; it must be packages/node/dist/index.js.
ENGRAM_NODE_PACKAGE_PATH=
# SHA-256 of every regular file in packages/node/dist, path-sorted and delimited.
ENGRAM_EXPECTED_PACKAGE_SHA256=
ENGRAM_NODE_PACKAGE=@engram/node
ENGRAM_DB_PATH=
ENGRAM_CONFIG_JSON=
# Pi Mono is server-only; provide a provider/model and credential in .env.local.
PI_PROVIDER=
PI_MODEL=
PI_API_KEY=
# The app calls Ollama's OpenAI-compatible API only at this local endpoint.
OLLAMA_OPENAI_URL=http://127.0.0.1:11434/v1
# Enables the real local Ollama smoke only; ordinary tests use the fixture path.
OLLAMA_INTEGRATION=0
# Integration-test target (requires a running Ollama service):
# PI_PROVIDER=ollama
# PI_MODEL=glm-5.2:cloud
# Native build prerequisite: cargo and rustc >= 1.85 (build outside Next.js).

# Production requires the exact public HTTPS origin for same-origin mutation checks.
# Do not put credentials in this file; provision production accounts outside the app runtime.
ODYSSEY_APP_ORIGIN=https://app.example.invalid
# Disabled by default. This only enables generic fixtures when NODE_ENV=development;
# it is ignored in production. Vitest supplies its own test-only fixture setting.
ODYSSEY_ENABLE_DEVELOPMENT_FIXTURE_ACCOUNTS=0

# Local development first-parent bootstrap. Supply real values only in ignored
# app/.env.local. The bootstrap is rejected outside NODE_ENV=development.
ODYSSEY_ENABLE_LOCAL_PARENT_BOOTSTRAP=0
ODYSSEY_PARENT_BOOTSTRAP_USERNAME=parent
ODYSSEY_PARENT_BOOTSTRAP_PASSWORD=replace-with-a-long-local-secret
