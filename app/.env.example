# Odyssey Learning — configuration template.
# Copy to .env.local (git-ignored) and fill in what you need.
# Nothing here is required to run the app on the reviewed question bank.

# ── Optional: local question generation ──────────────────────────────
# Pi Mono is server-only; provide a provider/model and credential in .env.local.
PI_PROVIDER=
PI_MODEL=
PI_API_KEY=
# The app calls Ollama's OpenAI-compatible API only at this local endpoint.
OLLAMA_OPENAI_URL=http://127.0.0.1:11434/v1
# Enables the real local Ollama integration; ordinary tests use the bank path.
OLLAMA_INTEGRATION=0
# Integration-test target (requires a running Ollama-compatible service):
# PI_PROVIDER=ollama
# PI_MODEL=<model>

# ── Deployment origin ────────────────────────────────────────────────
# Production requires the exact public origin for same-origin mutation checks.
ODYSSEY_APP_ORIGIN=https://app.example.invalid

# ── Data locations (defaults: ./data inside this package) ────────────
# Absolute paths only. The learning database holds every learner's history.
# ODYSSEY_DB_PATH=/absolute/path/odyssey-learning.db
# ODYSSEY_CURRICULUM_DB_PATH=/absolute/path/odyssey-curriculum.db
# Set to 0 only for tests that build exact catalog fixtures.
ODYSSEY_SEED_CATALOG=1

# ── Development fixtures ─────────────────────────────────────────────
# Disabled by default. This only enables fixture sign-ins when
# NODE_ENV=development; it is ignored in production. Vitest supplies its
# own test-only fixture setting.
ODYSSEY_ENABLE_DEVELOPMENT_FIXTURE_ACCOUNTS=0

# ── First-parent bootstrap ───────────────────────────────────────────
# Disabled by default and has no public route. Set exactly one
# environment-specific flag plus both secret values only in ignored local
# or deployment secret configuration. It only creates a parent while no
# parent account exists; it never resets an existing parent.
ODYSSEY_ENABLE_LOCAL_PARENT_BOOTSTRAP=0
ODYSSEY_ENABLE_PRODUCTION_PARENT_BOOTSTRAP=0
ODYSSEY_PARENT_BOOTSTRAP_USERNAME=
ODYSSEY_PARENT_BOOTSTRAP_PASSWORD=
